# =============================================
# StudyMate Backend Environment Configuration
# =============================================
# Copy this file to .env and fill in your values

# MongoDB Connection String (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studymate?retryWrites=true&w=majority

# JWT Secret — use a long, random string (min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_replace_this_in_production

# Google Gemini API Key — obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server port
PORT=5000

# Node environment
NODE_ENV=development
